amends "package://github.com/jdx/hk/releases/download/v1.48.0/hk@1.48.0#/Config.pkl"

// Git hooks managed by hk (https://hk.jdx.dev). Installed on devenv shell entry
// (`hk install`, idempotent) — the whole fresh-clone bootstrap is `direnv allow`.
//
// The pre-push gate is a thin shell over the local CI command: `devenv tasks run ci` runs
// the crate fmt/clippy/nextest (live suite excluded) plus the shared markdownlint/actionlint/
// nixfmt/deadnix lint tasks. Same command CI's gate job runs (.github/workflows/ci.yml).
//
// Bypass knobs:
//   HK=0 git push           // skip all hooks (emergency)
//   git push --no-verify    // hk respects this too

default_branch = "main"

hooks {
    ["pre-push"] {
        steps {
            ["ci"] = new Step {
                check = "devenv tasks run ci"
            }
        }
    }
}
